# Indian residential/ISP proxy so requests exit from an Indian IP, e.g. http://user:pass@in.proxy-provider.com:8000
INDIA_PROXY_URL=

# https://data.gov.in -> My Account -> API key
DATA_GOV_IN_API_KEY=

# https://apisetu.gov.in -> Developer dashboard
API_SETU_CLIENT_ID=
API_SETU_API_KEY=

# Free alternative to a proxy: your own home connection via relay/ (see relay/README.md)
INDIA_RELAY_URL=
INDIA_RELAY_TOKEN=
